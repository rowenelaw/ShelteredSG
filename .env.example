# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LTA_ACCOUNT_KEY: Required for server-side /api/busarrival proxy to LTA DataMall v3.
# Set this in Vercel Environment Variables or AI Studio Secrets (never expose in client code).
LTA_ACCOUNT_KEY="MY_LTA_ACCOUNT_KEY"

# ONEMAP_EMAIL & ONEMAP_PASSWORD: Required for server-side /api/onemap token generation (3-day token).
# Set these in Vercel Environment Variables or AI Studio Secrets (never expose in client code).
ONEMAP_EMAIL="MY_ONEMAP_EMAIL"
ONEMAP_PASSWORD="MY_ONEMAP_PASSWORD"

# ONEMAP_API_TOKEN: Optional static OneMap token (used if ONEMAP_EMAIL/ONEMAP_PASSWORD are not set).
ONEMAP_API_TOKEN="MY_ONEMAP_API_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
